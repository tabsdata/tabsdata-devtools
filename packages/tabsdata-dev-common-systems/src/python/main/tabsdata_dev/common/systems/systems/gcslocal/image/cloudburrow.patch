 // xmlPutObject is PUT /{bucket}/{object}: a whole object in the body.
 func (s *Server) xmlPutObject(w http.ResponseWriter, r *http.Request, bucket, name string) {
+	if src := r.Header.Get("X-Goog-Copy-Source"); src != "" {
+		s.xmlCopyObject(w, r, bucket, name, src)
+		return
+	}
 	meta, err := xmlMeta(r, name)
 	if err == nil {
 		err = s.bucketExists(bucket)
@@ -141,6 +145,28 @@ func (s *Server) xmlPutObject(w http.ResponseWriter, r *http.Request, bucket, na
 	w.WriteHeader(http.StatusOK)
 }
 
+// xmlCopyObject is PUT /{bucket}/{object} with x-goog-copy-source:
+// {srcBucket}/{srcObject}, served by the JSON API's objects.copy.
+func (s *Server) xmlCopyObject(w http.ResponseWriter, r *http.Request, bucket, name, src string) {
+	src, err := url.PathUnescape(strings.TrimPrefix(src, "/"))
+	srcBucket, srcObject, found := strings.Cut(src, "/")
+	if err != nil || !found || srcBucket == "" || srcObject == "" {
+		writeXMLError(w, http.StatusBadRequest, "InvalidArgument", "x-goog-copy-source must be {bucket}/{object}")
+		return
+	}
+	q := url.Values{}
+	for h, p := range map[string]string{"X-Goog-If-Generation-Match": "ifGenerationMatch", "X-Goog-If-Metageneration-Match": "ifMetagenerationMatch"} {
+		if v := r.Header.Get(h); v != "" {
+			q.Set(p, v)
+		}
+	}
+	jr := r.Clone(r.Context())
+	jr.Body = http.NoBody
+	jr.ContentLength = 0
+	s.viaJSON(w, jr, s.objectsCopy, jsonPrefix+"b/"+escape(srcBucket)+"/o/"+escape(srcObject)+
+		"/copyTo/b/"+escape(bucket)+"/o/"+escape(name), q, http.StatusOK)
+}
+
 // viaJSON runs a JSON API handler for an XML request, at jsonPath with
 // extra query parameters, and translates an error into the XML API's.
 // ok is the status the XML API answers success with.
