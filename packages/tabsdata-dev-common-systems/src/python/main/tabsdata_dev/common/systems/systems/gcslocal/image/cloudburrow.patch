# Our patch over cloudburrow (see Dockerfile): ListObjectsV2 continuation tokens
# and x-goog-copy-source in the XML API. Text before the first diff is ignored
# by git apply.

diff --git a/internal/service/storage/xmlops.go b/internal/service/storage/xmlops.go
