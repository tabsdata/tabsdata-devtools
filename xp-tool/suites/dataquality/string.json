[
  {
    "_comment": "DATAQUALITY · String classifiers (HasLength length range; Matches / DoesNotMatch regex search) over a string column; null -> NULL sentinel, never nan. Every test is a pub->tfr->sub chain over dq_src (DataGenSrc) / dq_ops (@transformer with on_tables=[DataQuality]) / dq_sink (TrashDest): the transformer passes its input through and carries the data-quality action under test, the server applies it to the output tables (rewriting in place and/or registering derived tables), and the subscriber asserts each resulting table matches its authored expected frame (see functions/_harness.py). Generated by gen_suites.py."
  },
  {
    "domain-manifest": {
      "domains": [
        {
          "name": "${xp:name(dev)}",
          "system": "dev",
          "model": null,
          "data": null
        }
      ]
    }
  },
  {
    "collections": [
      {
        "name": "dq_src",
        "type": "datagen_in",
        "connection_template": "connection-file:connections/datagen_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(dev)}"
        }
      },
      {
        "name": "dq_ops",
        "type": "transform",
        "group": "ops"
      },
      {
        "name": "dq_sink",
        "type": "trash_out",
        "connection_template": "connection-file:connections/trash_out.yaml",
        "group": "destinations",
        "domains": {
          "D0": "${xp:name(dev)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "dq_src",
        "functionpath": "functions/dq_has_length.py::hl_pub"
      },
      {
        "collection": "dq_ops",
        "functionpath": "functions/dq_has_length.py::hl_tfr"
      },
      {
        "collection": "dq_sink",
        "functionpath": "functions/dq_has_length.py::hl_sub"
      },
      {
        "collection": "dq_src",
        "functionpath": "functions/dq_matches.py::mt_pub"
      },
      {
        "collection": "dq_ops",
        "functionpath": "functions/dq_matches.py::mt_tfr"
      },
      {
        "collection": "dq_sink",
        "functionpath": "functions/dq_matches.py::mt_sub"
      },
      {
        "collection": "dq_src",
        "functionpath": "functions/dq_does_not_match.py::dnm_pub"
      },
      {
        "collection": "dq_ops",
        "functionpath": "functions/dq_does_not_match.py::dnm_tfr"
      },
      {
        "collection": "dq_sink",
        "functionpath": "functions/dq_does_not_match.py::dnm_sub"
      }
    ]
  },
  {
    "triggers": [
      {
        "collection": "dq_src",
        "function": "hl_pub",
        "detached": true
      },
      {
        "collection": "dq_src",
        "function": "mt_pub",
        "detached": true
      },
      {
        "collection": "dq_src",
        "function": "dnm_pub",
        "detached": true
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
