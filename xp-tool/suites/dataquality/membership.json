[
  {
    "_comment": "DATAQUALITY · Membership classifiers (IsIn / IsNotIn) with a values set; a null row is the NULL sentinel unless None is a member of the set. Every test is a pub->tfr->sub chain over dq_src (DataGenSrc) / dq_ops (@transformer with on_tables=[DataQuality]) / dq_sink (TrashDest): the transformer passes its input through and carries the data-quality action under test, the server applies it to the output tables (rewriting in place and/or registering derived tables), and the subscriber asserts each resulting table matches its authored expected frame (see functions/_harness.py). Generated by gen_suites.py."
  },
  {
    "domain-manifest": {
      "domains": [
        {
          "name": "${xp_name(dev)}",
          "system": "dev",
          "model": null,
          "data": null
        }
      ]
    }
  },
  {
    "collections": [
      {
        "name": "dq_src",
        "type": "datagen_in",
        "connection_template": "connection-file:connections/datagen_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp_name(dev)}"
        }
      },
      {
        "name": "dq_ops",
        "type": "transform",
        "group": "ops"
      },
      {
        "name": "dq_sink",
        "type": "trash_out",
        "connection_template": "connection-file:connections/trash_out.yaml",
        "group": "destinations",
        "domains": {
          "D0": "${xp_name(dev)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "dq_src",
        "functionpath": "functions/dq_is_in.py::iin_pub"
      },
      {
        "collection": "dq_ops",
        "functionpath": "functions/dq_is_in.py::iin_tfr"
      },
      {
        "collection": "dq_sink",
        "functionpath": "functions/dq_is_in.py::iin_sub"
      },
      {
        "collection": "dq_src",
        "functionpath": "functions/dq_is_not_in.py::ini_pub"
      },
      {
        "collection": "dq_ops",
        "functionpath": "functions/dq_is_not_in.py::ini_tfr"
      },
      {
        "collection": "dq_sink",
        "functionpath": "functions/dq_is_not_in.py::ini_sub"
      }
    ]
  },
  {
    "triggers": [
