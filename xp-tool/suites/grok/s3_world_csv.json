    "domain-manifest": {
      "domains": [
        {
          "name": "${xp_name(s3_world_xs)}",
          "system": "s3",
          "model": "world",
          "data": "xs"
        },
        {
          "name": "${xp_name(dev)}",
          "system": "dev",
          "model": null,
          "data": null
        }
      ]
    }
  },
