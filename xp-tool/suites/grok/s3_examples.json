[
  {
    "_comment": "GROK · The examples suite with the storage swapped to S3: the same TableFrame.grok transformers, but the log lines are read from an S3 domain and the parquet marts land in one. What changes between local files and an object store is ONLY the publisher's source and the subscriber's destination. Each example is a pub->tfr->sub chain over gk_logs (S3Src with SrcFileFormat.LOG, globbing the staged world CSVs out of the S3 domain's bucket prefix) / gk_marts (the SAME transformer objects as the examples suite, imported by gk_s3ex.py, since a transform collection has no connection) / gk_out (S3Dest, landing the same parquet names in the S3 out domain). Generated by gen_suites.py."
  },
  {
    "domain-manifest": {
      "domains": [
        {
          "name": "${xp_name(s3_world_xs)}",
          "system": "s3",
          "model": "world",
          "data": "xs"
        },
        {
          "name": "${xp_name(s3_out)}",
          "system": "s3",
          "model": null,
          "data": null
        }
      ]
    }
  },
  {
    "collections": [
      {
        "name": "gk_logs",
        "type": "s3_file_in",
        "connection_template": "connection-file:connections/s3_file_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp_name(s3_world_xs)}"
        }
      },
      {
        "name": "gk_marts",
        "type": "transform",
        "group": "marts"
      },
      {
        "name": "gk_out",
        "type": "s3_file_out",
        "connection_template": "connection-file:connections/s3_file_out.yaml",
        "group": "destinations",
        "domains": {
          "D0": "${xp_name(s3_out)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "gk_logs",
        "functionpath": "functions/gk_s3ex.py::city_log_pub"
      },
      {
        "collection": "gk_logs",
        "functionpath": "functions/gk_s3ex.py::lang_log_pub"
      },
      {
        "collection": "gk_logs",
        "functionpath": "functions/gk_s3ex.py::jn_log_pub"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::parse_city_log"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::mart_big_cities"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::parse_lang_log"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::mart_official_languages"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::jn_parse_cities"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::jn_parse_languages"
      },
      {
        "collection": "gk_marts",
        "functionpath": "functions/gk_s3ex.py::mart_city_languages"
      },
      {
        "collection": "gk_out",
        "functionpath": "functions/gk_s3ex.py::cities_out"
      },
      {
        "collection": "gk_out",
        "functionpath": "functions/gk_s3ex.py::big_cities_out"
      },
      {
        "collection": "gk_out",
        "functionpath": "functions/gk_s3ex.py::languages_out"
      },
      {
        "collection": "gk_out",
        "functionpath": "functions/gk_s3ex.py::official_languages_out"
      },
      {
        "collection": "gk_out",
        "functionpath": "functions/gk_s3ex.py::city_languages_out"
      }
    ]
  },
  {
    "triggers": [
      {
        "collection": "gk_logs",
        "function": "city_log_pub",
        "detached": true
      },
      {
        "collection": "gk_logs",
        "function": "lang_log_pub",
        "detached": true
      },
      {
        "collection": "gk_logs",
        "function": "jn_log_pub",
        "detached": true
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
