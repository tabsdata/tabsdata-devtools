[
  {
    "_copyright": "Copyright 2026 Tabsdata Inc.",
    "_comment": "CAPABILITY suite: Kafka stream publishers over topics of DIFFERENT PARTITION COUNTS, one topic or several, alone in a consumer group or sharing one. Functions in functions/caps_kafka_topics.py. The redpanda domain's create-model --up-to-partitions 4 gives the employees model's topics 1 to 4 partitions in turn (departments 1, employees 2, dept_emp 3, dept_manager 4, titles 1, salaries 2), and every message is keyed by its row's first field, so a row lands on the same partition every run. Collections, each its own consumer group: parts_regex (kafka_topic_in_multi.yaml) -- kafka_three_of_four, ONE publisher over departments, employees and dept_emp, 1 + 2 + 3 partitions; parts_single (kafka_topic_in.yaml) -- kafka_one_topic over dept_manager, one consumer owning all 4 partitions; parts_shared (kafka_topic_in_shared.yaml) -- kafka_shared_a and kafka_shared_b over dept_emp, TWO publishers in ONE group, which splits its 3 partitions between them. STAGES: (1) domains -- the domain, its topics and the xs seed to every topic, appended to ${xp:dir}/ops.jsonl; (2) actions, tagged live -- `produce` in the background: 6 passes 15s apart of `modify-data`, a fresh batch to every topic, running while (3) the collections are created and (4) the publishers registered; (5) actions -- wait for produce, then scripts/verify_kafka.py per collection side by side, tagged check, each polling until every message arrived (at most 5m): parts_regex's three tables each hold their topic's messages exactly once and kafka_unrouted none; parts_single's kafka_dept_manager every dept_manager message once; parts_shared's two tables between them every dept_emp message -- duplicates allowed and counted: a partition the group hands from one publisher to the other before its offsets were committed is read by both; (6) monitor. Run: `tdd xp one-shot --suite kafka/kafka_partitions --keep`."
  },
  {
    "domains": [
      {
        "name": "${xp:name(redpanda)}",
        "command": "create",
        "options": [
          "--sys",
          "redpanda"
        ]
      },
      {
        "name": "${xp:name(redpanda)}",
        "command": "create-model",
        "options": [
          "--model",
          "employees",
          "--up-to-partitions",
          "4"
        ]
      },
      {
        "name": "${xp:name(redpanda)}",
        "command": "create-data",
        "options": [
          "--size",
          "1",
          "--emit-ops",
          "${xp:dir}/ops.jsonl"
        ]
      }
    ]
  },
  {
    "actions": [
      {
        "background": {
          "name": "produce",
          "tags": [
            "live"
          ],
          "actions": [
            {
              "loop": {
                "name": "produce-pass",
                "repeat": 6,
                "actions": [
                  {
                    "tdd": {
                      "name": "push",
                      "tool": "domain",
                      "command": "modify-data",
                      "options": [
                        "--domain",
                        "${xp:name(redpanda)}",
                        "--emit-ops",
                        "${xp:dir}/ops.jsonl"
                      ]
                    }
                  },
                  {
                    "sleep": {
                      "name": "pause",
                      "time": "15s"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "collections": [
      {
        "name": "parts_regex",
        "type": "kafka_topic_in",
        "connection_template": "connection-file:connections/kafka_topic_in_multi.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(redpanda)}"
        }
      },
      {
        "name": "parts_single",
        "type": "kafka_topic_in",
        "connection_template": "connection-file:connections/kafka_topic_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(redpanda)}"
        }
      },
      {
        "name": "parts_shared",
        "type": "kafka_topic_in",
        "connection_template": "connection-file:connections/kafka_topic_in_shared.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(redpanda)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "parts_regex",
        "functionpath": "functions/caps_kafka_topics.py::kafka_three_of_four"
      },
      {
        "collection": "parts_single",
        "functionpath": "functions/caps_kafka_topics.py::kafka_one_topic"
      },
      {
        "collection": "parts_shared",
        "functionpath": "functions/caps_kafka_topics.py::kafka_shared_a"
      },
      {
        "collection": "parts_shared",
        "functionpath": "functions/caps_kafka_topics.py::kafka_shared_b"
      }
    ]
  },
  {
    "actions": [
      {
        "wait": {
          "name": "produced",
          "tags": [
            "live"
          ],
          "for": [
            "produce"
          ]
        }
      },
      {
        "parallel": {
          "name": "verify",
          "tags": [
            "check"
          ],
          "lanes": 0,
          "actions": [
            {
              "python": {
                "name": "verify-regex",
                "script": "scripts/verify_kafka.py",
                "params": [
                  "${xp:dir}/ops.jsonl",
                  "parts_regex",
                  "--expect",
                  "kafka_departments=departments",
                  "--expect",
                  "kafka_employees=employees",
                  "--expect",
                  "kafka_dept_emp=dept_emp",
                  "--empty",
                  "kafka_unrouted",
                  "--time-out",
                  "5m",
                  "--profile",
                  "${td:profile}"
                ]
              }
            },
            {
              "python": {
                "name": "verify-single",
                "script": "scripts/verify_kafka.py",
                "params": [
                  "${xp:dir}/ops.jsonl",
                  "parts_single",
                  "--expect",
                  "kafka_dept_manager=dept_manager",
                  "--time-out",
                  "5m",
                  "--profile",
                  "${td:profile}"
                ]
              }
            },
            {
              "python": {
                "name": "verify-shared",
                "script": "scripts/verify_kafka.py",
                "params": [
                  "${xp:dir}/ops.jsonl",
                  "parts_shared",
                  "--expect",
                  "kafka_shared_a+kafka_shared_b=dept_emp",
                  "--allow-duplicates",
                  "--time-out",
                  "5m",
                  "--profile",
                  "${td:profile}"
                ]
              }
            }
          ]
        }
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
