[
  {
    "_copyright": "Copyright 2026 Tabsdata Inc.",
    "_comment": "CAPABILITY suite: a Kafka stream publisher DISABLED AND ENABLED, twice. functions/caps_kafka_topics.py::kafka_resume reads <prefix>.employees (trigger max_secs 15, for tests). The consumer commits its offsets on the broker once a batch is staged, and enabled again it must go on from there: no message lost, none staged twice. STAGES: (1) the domain, the xs seed appended to ${xp:dir}/ops.jsonl; (2) the collection and (3) the function, which STARTS it; (4) actions, tagged live, two rounds of: scripts/verify_kafka.py waits until every message so far is in kafka_resumed (so the pause comes after a commit), `tdk fn disable`, 20s for the worker to stop, a batch to employees while it is down, `tdk fn enable`, another batch; (5) actions, tagged check -- scripts/verify_kafka.py: every employees message in kafka_resumed exactly once, duplicates NOT allowed (polling at most 5m); (6) monitor. Run: `tdd xp one-shot --suite kafka/kafka_pause_resume --keep`."
  },
  {
    "domain-manifest": {
      "emit_ops": "${xp:dir}/ops.jsonl",
      "domains": [
        {
          "name": "${xp:name(redpanda)}",
          "system": "redpanda",
          "model": "employees",
          "data": "xs"
        }
      ]
    }
  },
  {
    "collections": [
      {
        "name": "resume",
        "type": "kafka_topic_in",
        "connection_template": "connection-file:connections/kafka_topic_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(redpanda)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "resume",
        "functionpath": "functions/caps_kafka_topics.py::kafka_resume"
      }
    ]
  },
  {
    "actions": [
      {
        "python": {
          "name": "arrived-1",
          "script": "scripts/verify_kafka.py",
          "params": [
            "${xp:dir}/ops.jsonl",
            "resume",
            "--expect",
            "kafka_resumed=employees",
            "--time-out",
            "5m",
            "--profile",
            "${td:profile}"
          ],
          "tags": [
            "live"
          ]
        }
      },
      {
        "tdd": {
          "name": "disable-1",
          "tags": [
            "live"
          ],
          "tool": "tdk",
          "command": "fn",
          "options": [
            "disable",
            "--proj",
            "${xp:project}",
            "--coll",
            "resume",
            "--name",
            "kafka_resume",
            "--profile",
            "${td:profile}"
          ]
        }
      },
      {
        "sleep": {
          "name": "stopping-1",
          "tags": [
            "live"
          ],
          "time": "20s"
        }
      },
      {
        "tdd": {
          "name": "push-paused-1",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "modify-data",
          "options": [
            "--domain",
            "${xp:name(redpanda)}",
            "--entity",
            "employees",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      },
      {
        "tdd": {
          "name": "enable-1",
          "tags": [
            "live"
          ],
          "tool": "tdk",
          "command": "fn",
          "options": [
            "enable",
            "--proj",
            "${xp:project}",
            "--coll",
            "resume",
            "--name",
            "kafka_resume",
            "--profile",
            "${td:profile}"
          ]
        }
      },
      {
        "tdd": {
          "name": "push-resumed-1",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "modify-data",
          "options": [
            "--domain",
            "${xp:name(redpanda)}",
            "--entity",
            "employees",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      },
      {
        "python": {
          "name": "arrived-2",
          "script": "scripts/verify_kafka.py",
          "params": [
            "${xp:dir}/ops.jsonl",
            "resume",
            "--expect",
            "kafka_resumed=employees",
            "--time-out",
            "5m",
            "--profile",
            "${td:profile}"
          ],
          "tags": [
            "live"
          ]
        }
      },
      {
        "tdd": {
          "name": "disable-2",
          "tags": [
            "live"
          ],
          "tool": "tdk",
          "command": "fn",
          "options": [
            "disable",
            "--proj",
            "${xp:project}",
            "--coll",
            "resume",
            "--name",
            "kafka_resume",
            "--profile",
            "${td:profile}"
          ]
        }
      },
      {
        "sleep": {
          "name": "stopping-2",
          "tags": [
            "live"
          ],
          "time": "20s"
        }
      },
      {
        "tdd": {
          "name": "push-paused-2",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "modify-data",
          "options": [
            "--domain",
            "${xp:name(redpanda)}",
            "--entity",
            "employees",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      },
      {
        "tdd": {
          "name": "enable-2",
          "tags": [
            "live"
          ],
          "tool": "tdk",
          "command": "fn",
          "options": [
            "enable",
            "--proj",
            "${xp:project}",
            "--coll",
            "resume",
            "--name",
            "kafka_resume",
            "--profile",
            "${td:profile}"
          ]
        }
      },
      {
        "tdd": {
          "name": "push-resumed-2",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "modify-data",
          "options": [
            "--domain",
            "${xp:name(redpanda)}",
            "--entity",
            "employees",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      }
    ]
  },
  {
    "actions": [
      {
        "python": {
          "name": "verify-resumed",
          "script": "scripts/verify_kafka.py",
          "params": [
            "${xp:dir}/ops.jsonl",
            "resume",
            "--expect",
            "kafka_resumed=employees",
            "--time-out",
            "5m",
            "--profile",
            "${td:profile}"
          ],
          "tags": [
            "check"
          ]
        }
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
