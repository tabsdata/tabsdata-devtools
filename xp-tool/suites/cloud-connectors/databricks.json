    "domain-manifest": {
      "domains": [
        {
          "name": "${xp:name(dev)}",
          "system": "dev"
        },
        {
          "name": "${xp:name(world_xs)}",
          "system": "databricks",
          "model": "world",
          "size": 1
        },
        {
          "name": "${xp:name(databricks)}",
          "system": "databricks"
        }
      ]
    }
  },
  {
    "collections": [
      {
        "name": "caps_input",
        "type": "datagen_in",
        "connection_template": "connection-file:connections/datagen_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(dev)}"
        }
      },
      {
        "name": "databricks_in",
        "type": "databricks_bulk_in",
        "connection_template": "connection-file:connections/databricks_bulk_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(world_xs)}"
        }
