      {
        "name": "databricks_out",
        "type": "databricks_bulk_out",
        "connection_template": "connection-file:connections/databricks_bulk_out.yaml",
        "group": "destinations",
        "domains": {
          "D0": "${xp:name(databricks)}"
        }
      },
      {
        "name": "databricks_meta",
        "type": "transform",
        "group": "ops"
      }
    ]
  },
