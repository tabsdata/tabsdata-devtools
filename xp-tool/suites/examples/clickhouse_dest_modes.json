[
  {
    "_copyright": "Copyright 2026 Tabsdata Inc.",
    "_comment": "EXAMPLE · ClickHouse destination / write modes. The shape is the SQL-destination one (one write slot per `tables` entry, append vs replace, a returned None skipping the write without truncating, types decided only when the table is created). What a BULK destination adds is a STAGING HOP — the frame is written to a staging area and the warehouse ingests it, which is why these load fast and why they have a prerequisite a plain database does not. Four sinks: write_append, write_replace, write_two_tables, write_nothing. One function per file under functions/clickhouse_dest_modes/. Run: `tdd xp one-shot --suite examples/clickhouse_dest_modes --keep`."
  },
  {
    "domain-manifest": {
      "domains": [
        {
          "name": "${xp_name(dev)}",
          "system": "dev"
        },
        {
          "name": "${xp_name(clickhouse_out)}",
          "system": "clickhouse"
        },
        {
          "name": "${xp_name(stage_store)}",
          "system": "s3"
        }
      ]
    }
  },
  {
    "collections": [
      {
        "name": "gen",
        "type": "datagen_in",
        "group": "sources",
        "connection_template": "connection-file:connections/datagen_in.yaml",
        "domains": {
          "D0": "${xp_name(dev)}"
        }
      },
      {
        "name": "warehouse",
        "type": "clickhouse_bulk_out_s3",
        "group": "destinations",
        "connection_template": "connection-file:connections/clickhouse_bulk_out_s3.yaml",
        "domains": {
          "D0": "${xp_name(clickhouse_out)}",
          "D1": "${xp_name(stage_store)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "gen",
        "functionpath": "functions/clickhouse_dest_modes/supporting_generate_customers.py::generate_customers"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/clickhouse_dest_modes/write_append.py::write_append"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/clickhouse_dest_modes/write_replace.py::write_replace"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/clickhouse_dest_modes/write_nothing.py::write_nothing"
      }
    ]
  },
  {
    "triggers": [
      {
        "collection": "gen",
        "function": "generate_customers",
        "detached": true
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
