[
  {
    "_copyright": "Copyright 2026 Tabsdata Inc.",
    "_comment": "EXAMPLE · BigQuery destination / write modes. The shape is the SQL-destination one (one write slot per `tables` entry, append vs replace, a returned None skipping the write without truncating, types decided only when the table is created). What a BULK destination adds is a STAGING HOP — the frame is written to a staging area and the warehouse ingests it, which is why these load fast and why they have a prerequisite a plain database does not. Four sinks: write_append, write_replace, write_two_tables, write_nothing. One function per file under functions/bigquery_dest_modes/. Run: `tdx-xp oneshot --suite examples/bigquery_dest_modes --keep`."
  },
  {
    "domains": [
      {
        "name": "dev",
        "system": "dev"
      },
      {
        "name": "bigquery_out",
        "system": "bigquery"
      }
    ]
  },
  {
    "collections": [
      {
        "name": "gen",
        "type": "datagen_in",
        "group": "sources",
        "connection_template": "connection-file:connections/datagen_in.yaml",
        "domains": {
          "D0": "dev"
        }
      },
      {
        "name": "warehouse",
        "type": "bigquery_bulk_out",
        "group": "destinations",
        "connection_template": "connection-file:connections/bigquery_bulk_out.yaml",
        "domains": {
          "D0": "bigquery_out"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "gen",
        "functionpath": "functions/bigquery_dest_modes/supporting_generate_customers.py::generate_customers"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/bigquery_dest_modes/write_append.py::write_append"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/bigquery_dest_modes/write_replace.py::write_replace"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/bigquery_dest_modes/write_two_tables.py::write_two_tables"
      },
      {
        "collection": "warehouse",
        "functionpath": "functions/bigquery_dest_modes/write_nothing.py::write_nothing"
      }
    ]
  },
  {
    "triggers": [
      {
        "collection": "gen",
        "function": "generate_customers",
        "detached": true
      }
    ]
  },
  {
    "monitor": true
  }
]
