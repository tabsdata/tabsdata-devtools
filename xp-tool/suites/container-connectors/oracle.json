        "detached": true
      },
      {
        "collection": "oracle_in",
        "function": "oracle_in",
        "detached": true
      },
      {
        "collection": "oracle_in",
        "function": "oracle_in_inc",
        "detached": true
      },
      {
        "collection": "oracle_in",
        "function": "oracle_in_multiquery",
        "detached": true
