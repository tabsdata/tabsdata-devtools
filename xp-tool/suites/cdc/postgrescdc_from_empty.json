[
  {
    "_comment": "CDC scenario FROM EMPTY: PostgreSQL CDC over logical decoding (wal2json) of the domain's own replication slot (created with the domain, named after it, reused by the publisher); every model table REPLICA IDENTITY FULL, so the two keyless tables log their updates and deletes with whole before-images. wal2json carries the rows an ON DELETE CASCADE takes and an UPDATE that sets the values a row has: --cascades logged --noops logged. The model is installed and holds NO data when the stream starts, so everything it carries arrives as changes, from zero. STAGES: (1) domains -- create the postgrescdc domain and install employeescdc, no create-data; (2) actions, tagged live -- `sentinel-data --key before-stream`, the one row the stream's initial load finds; (3) collections and (4) functions -- register postgrescdc_initial_load (initial_load=True), which STARTS it: its load is the empty tables and that sentinel; (5) sentinel -- hold until before-stream arrives, so the load is done before any data exists; (6) actions, tagged live -- the seed (`create-data --size 1`, one transaction), one `modify-data --ops Mix --sets 10` pass, `sentinel-data --key after-changes`; (7) sentinel -- hold until after-changes arrives; (8) actions, tagged check -- scripts/verify_cdc_ops.py --start initial-load: the load holds the sentinel alone, and the seed and every change after it arrive one by one, in their transactions, nothing of audit; (9) monitor. Generated by gen_suites.py. Run: `tdd xp one-shot --suite cdc/postgrescdc_from_empty --keep`."
  },
  {
    "domains": [
      {
        "name": "${xp:name(employeescdc_empty)}",
        "command": "create",
        "options": [
          "--sys",
          "postgrescdc"
        ]
      },
      {
        "name": "${xp:name(employeescdc_empty)}",
        "command": "create-model",
        "options": [
          "--model",
          "employeescdc"
        ]
      }
    ]
  },
  {
    "actions": [
      {
        "tdd": {
          "name": "sentinel-empty",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "sentinel-data",
          "options": [
            "--domain",
            "${xp:name(employeescdc_empty)}",
            "--key",
            "before-stream",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      }
    ]
  },
  {
    "collections": [
      {
        "name": "postgrescdc_from_empty",
        "type": "postgres_cdc",
        "connection_template": "connection-file:connections/postgres_cdc.yaml",
        "group": "sources",
        "domains": {
          "D0": "${xp:name(employeescdc_empty)}"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "postgrescdc_from_empty",
        "functionpath": "functions/caps_postgrescdc_initial_load.py::postgrescdc_initial_load"
      }
    ]
  },
  {
    "sentinel": [
      {
        "collection": "postgrescdc_from_empty",
        "table": "xp_sentinel_changes",
        "wait_for_key": "before-stream",
        "time_out": "5m"
      }
    ]
  },
  {
    "actions": [
      {
        "tdd": {
          "name": "seed",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "create-data",
          "options": [
            "--domain",
            "${xp:name(employeescdc_empty)}",
            "--size",
            "1",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      },
      {
        "tdd": {
          "name": "change",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "modify-data",
          "options": [
            "--domain",
            "${xp:name(employeescdc_empty)}",
            "--ops",
            "Mix",
            "--sets",
            "10",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      },
      {
        "tdd": {
          "name": "sentinel-changed",
          "tags": [
            "live"
          ],
          "tool": "domain",
          "command": "sentinel-data",
          "options": [
            "--domain",
            "${xp:name(employeescdc_empty)}",
            "--key",
            "after-changes",
            "--emit-ops",
            "${xp:dir}/ops.jsonl"
          ]
        }
      }
    ]
  },
  {
    "sentinel": [
      {
        "collection": "postgrescdc_from_empty",
        "table": "xp_sentinel_changes",
        "wait_for_key": "after-changes",
        "time_out": "5m"
      }
    ]
  },
  {
    "actions": [
      {
        "python": {
          "name": "verify-ops",
          "tags": [
            "check"
          ],
          "script": "scripts/verify_cdc_ops.py",
          "params": [
            "${xp:dir}/ops.jsonl",
            "postgrescdc_from_empty",
            "--cascades",
            "logged",
            "--noops",
            "logged",
            "--start",
            "initial-load",
            "--untracked",
            "audit",
            "${td:profile}"
          ]
        }
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
