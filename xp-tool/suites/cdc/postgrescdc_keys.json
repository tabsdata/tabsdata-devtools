      {
        "python": {
          "name": "verify-postgrescdc_head",
          "tags": [
            "check"
          ],
          "script": "scripts/verify_cdc_ops.py",
          "params": [
            "${xp:dir}/ops.jsonl",
            "postgrescdc_head",
            "--cascades",
            "logged",
            "--noops",
            "logged",
            "--start",
            "tail",
            "--untracked",
            "audit",
            "--profile",
            "${td:profile}"
          ],
          "continue_on_fail": true
        }
      }
    ]
  },
  {
    "monitor": {
      "time_out": "30m"
    }
  }
]
