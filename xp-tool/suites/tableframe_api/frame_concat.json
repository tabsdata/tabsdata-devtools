[
  {
    "_comment": "TABLEFRAME_API · functions.concat (vertical / diagonal). Every test is a pub->tfr->sub chain over tf_src (DataGenSrc) / tf_ops (@transformer) / tf_sink (TrashDest): the transformer applies the operation(s) under test via the TableFrame API and the subscriber re-applies the same operation in polars and asserts equality (see functions/_harness.py). Generated by gen_suites.py."
  },
  {
    "domains": [
      {
        "name": "dev",
        "command": "create",
        "options": [
          "--sys",
          "dev"
        ]
      }
    ]
  },
  {
    "collections": [
      {
        "name": "tf_src",
        "type": "datagen_in",
        "connection_template": "connection-file:connections/datagen_in.yaml",
        "group": "sources",
        "domains": {
          "D0": "dev"
        }
      },
      {
        "name": "tf_ops",
        "type": "transform",
        "group": "ops"
      },
      {
        "name": "tf_sink",
        "type": "trash_out",
        "connection_template": "connection-file:connections/trash_out.yaml",
        "group": "destinations",
        "domains": {
          "D0": "dev"
        }
      }
    ]
  },
  {
    "functions": [
      {
        "collection": "tf_src",
        "functionpath": "functions/tf_concat.py::cc_pub"
      },
      {
        "collection": "tf_ops",
        "functionpath": "functions/tf_concat.py::cc_tfr"
      },
      {
        "collection": "tf_sink",
        "functionpath": "functions/tf_concat.py::cc_sub"
      }
    ]
  },
  {
    "triggers": [
      {
        "collection": "tf_src",
        "function": "cc_pub",
        "detached": true
      }
    ]
  },
  {
    "monitor": true
  }
]
